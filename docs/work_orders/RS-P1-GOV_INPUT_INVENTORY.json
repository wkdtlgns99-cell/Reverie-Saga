  "probe_expectations": [
    {
      "id": "IMPORT_ALLOWED",
      "edges": [
        "app.entry -> adapters.port",
        "adapters.port -> orchestration.driver",
        "orchestration.driver -> contracts.port",
        "engines.skeleton -> contracts.port",
        "contracts.port -> domain.value"
      ],
      "expected": "both contracts KEPT; exit 0"
    },
    {
      "id": "IMPORT_REVERSE",
      "add_edge": "domain.value -> app.entry",
      "expected": "layer contract BROKEN; diagnostic has violating edge; nonzero exit"
    },
    {
      "id": "IMPORT_INDIRECT",
      "add_edges": [
        "domain.value -> contracts.port",
        "contracts.port -> app.entry"
      ],
      "expected": "layer contract BROKEN; chain through contracts.port; nonzero exit"
    },
    {
      "id": "IMPORT_ENGINE",
      "add_edge": "engines.skeleton -> engines.trial",
      "expected": "independence contract BROKEN; nonzero exit"
    },
    {
      "id": "IMPORT_ENGINE_INDIRECT",
      "add_edges": [
        "engines.skeleton -> domain.value",
        "domain.value -> engines.trial"
      ],
      "expected": "independence contract BROKEN; transitive chain; nonzero exit"
    },
    {
      "id": "IMPORT_TYPE_CHECKING",
      "type_checking_edge": "domain.value -> app.entry",
      "expected": "layer contract BROKEN despite TYPE_CHECKING"
    },
    {
      "id": "IMPORT_NAMESPACE",
      "expected": "adapters.port present without adapters/__init__.py; allowed case KEPT"
    },
    {
      "id": "IMPORT_MISSING_ROOT",
      "remove_tree": "adapters",
      "expected": "missing required root/layer error; nonzero exit; no KEPT qualification"
    },
